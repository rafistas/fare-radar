# Chave da API da SerpApi (https://serpapi.com)
SERPAPI_API_KEY=

# Bot do Telegram (@BotFather) e seu Chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Configurações de rota e data (opcionais - padrão Cuiabá para João Pessoa em Nov/2026 e Dez/2026)
ORIGIN_IATA=CGB
DESTINATION_IATA=JPA
DEPARTURE_FROM=2026-11-01
DEPARTURE_TO=2026-12-31
MIN_DURATION=5
MAX_DURATION=8
CURRENCY=BRL
BATCH_SIZE=2

# Preço teto opcional para disparar alertas no Telegram (ex: 1200)
TARGET_PRICE=
